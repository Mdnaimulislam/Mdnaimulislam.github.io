---
import { site, links } from '../data/site';
import { publications } from '../data/publications';
import Icon from './Icon.astro';

const stats = [
  { value: String(publications.length), label: 'Publications' },
  { value: String(site.metrics.citations), label: 'Citations' },
  { value: String(site.metrics.hIndex), label: 'h-index' },
  { value: String(site.metrics.i10Index), label: 'i10-index' },
];
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="hero-kicker">
          {site.role} <span aria-hidden="true">·</span> {site.group}
        </p>
        <h1 class="hero-name">{site.name}</h1>
        <p class="hero-affiliation">
          {site.institution} <span class="hero-dot" aria-hidden="true">·</span>
          <span class="hero-location">{site.location}</span>
        </p>
        <p class="hero-tagline">{site.tagline}</p>

        <ul class="chip-row hero-interests">
          {site.interests.map((interest) => <li class="chip">{interest}</li>)}
        </ul>

        <ul class="hero-links">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel={link.href.startsWith('http') ? 'noopener' : undefined}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                >
                  <Icon name={link.icon} />
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-portrait">
        <picture>
          <source srcset="/img/portrait.webp" type="image/webp" />
          <img
            src="/img/portrait.jpg"
            width="360"
            height="360"
            alt={`Portrait of ${site.name}`}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>

    <dl class="hero-stats">
      {
        stats.map((stat) => (
          <div class="hero-stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
      <p class="hero-stats-note">
        <a href={site.metrics.source} target="_blank" rel="noopener">Google Scholar</a>, {site.metrics.asOf}
      </p>
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.75rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--s-3);
  }

  .hero-name {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.06;
    max-width: 16ch;
  }

  .hero-affiliation {
    margin: var(--s-3) 0 0;
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  .hero-dot {
    color: var(--ink-3);
    margin-inline: 0.35rem;
  }

  .hero-location {
    color: var(--ink-3);
  }

  .hero-tagline {
    margin: var(--s-5) 0 0;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 52ch;
    border-left: 2px solid var(--accent-line);
    padding-left: var(--s-4);
  }

  .hero-interests {
    margin-top: var(--s-5);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
  }

  .hero-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .hero-links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent-line);
  }

  .hero-portrait img {
    width: clamp(150px, 22vw, 232px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    filter: saturate(0.97);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4) clamp(1.75rem, 4vw, 3.5rem);
    margin: clamp(2.25rem, 5vw, 3.5rem) 0 0;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .hero-stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.1rem;
  }

  .hero-stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .hero-stat dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .hero-stats-note {
    margin: 0;
    margin-left: auto;
    font-size: var(--step--1);
    color: var(--ink-3);
    align-self: flex-end;
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }

    .hero-portrait {
      order: -1;
    }

    .hero-portrait img {
      width: 92px;
    }

    .hero-name {
      max-width: none;
    }

    .hero-tagline {
      font-size: var(--step-0);
    }

    .hero-stats {
      gap: var(--s-5) var(--s-6);
    }

    .hero-stats-note {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
