---
import { site, links } from '../data/site';
import Icon from './Icon.astro';

const profiles = links.filter((link) => link.icon !== 'email');
---

<div class="contact">
  <div class="contact-primary">
    <p class="contact-lede">
      I am always glad to hear from people working on multimodal learning, cardiovascular imaging or
      clinical AI, and from students looking for a project in this area.
    </p>
    <a class="contact-email" href={`mailto:${site.email}`}>
      <Icon name="email" size={18} />
      <span>{site.email}</span>
    </a>
    <address class="contact-address">
      {site.group}, {site.institution}<br />
      {site.officeAddress}
    </address>
  </div>

  <div class="contact-profiles">
    <h3 class="contact-profiles-title">Elsewhere</h3>
    <ul>
      {
        profiles.map((profile) => (
          <li>
            <a href={profile.href} target={profile.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <Icon name={profile.icon} size={15} />
              <span class="contact-profile-label">{profile.label}</span>
              {profile.handle && <span class="contact-profile-handle mono">{profile.handle}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .contact-lede {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 48ch;
    line-height: 1.6;
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-line);
    padding-bottom: 2px;
    word-break: break-word;
  }

  .contact-email:hover {
    border-bottom-color: var(--accent-hover);
  }

  .contact-address {
    margin-top: var(--s-5);
    font-style: normal;
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.7;
  }

  .contact-profiles-title {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-2);
  }

  .contact-profiles a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .contact-profiles a:hover {
    color: var(--accent);
  }

  .contact-profile-label {
    font-weight: 500;
  }

  .contact-profile-handle {
    margin-left: auto;
    font-size: var(--step--2);
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
  }
</style>
