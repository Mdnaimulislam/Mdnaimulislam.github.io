---
import { appointments, education } from '../data/cv';
---

<div class="split">
  <section aria-label="Appointments">
    <h3 class="split-title">Appointments</h3>
    <ol class="entries">
      {
        appointments.map((role) => (
          <li>
            <p class="entry-dates mono">
              {role.start} – {role.end}
            </p>
            <p class="entry-title">{role.role}</p>
            <p class="entry-org">
              {role.unit ? `${role.unit}, ` : ''}
              {role.org}, {role.location}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-label="Education">
    <h3 class="split-title">Education</h3>
    <ol class="entries">
      {
        education.map((degree) => (
          <li>
            <p class="entry-dates mono">
              {degree.start} – {degree.end}
            </p>
            <p class="entry-title">
              {degree.degree} in {degree.field}
              {degree.distinction && <span class="entry-note">{degree.distinction}</span>}
            </p>
            <p class="entry-org">
              {degree.org}, {degree.location}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .split-title {
    font-size: var(--step-0);
    font-weight: 600;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-3);
  }

  .entries li {
    padding-block: var(--s-3);
  }

  .entries li + li {
    border-top: 1px solid var(--line);
  }

  .entry-dates {
    margin: 0 0 0.15rem;
    color: var(--ink-3);
  }

  .entry-title {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 500;
    line-height: 1.45;
  }

  .entry-note {
    display: inline-block;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--accent);
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    border-radius: 100px;
    padding: 0.05em 0.55em;
    vertical-align: 1px;
  }

  .entry-org {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
  }
</style>
