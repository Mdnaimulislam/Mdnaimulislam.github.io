---
import { projects } from '../data/projects';
import ProjectDiagram from './ProjectDiagram.astro';
import Icon from './Icon.astro';

const diagramLabels: Record<string, string> = {
  cardiovae: 'Schematic: chest X-ray and ECG inputs fuse into a shared latent space that predicts haemodynamic instability.',
  lsemvae: 'Schematic: 12-lead ECG pre-training transfers into a 6-lead setting through a hierarchical modality expert, predicting pulmonary hypertension risk.',
  tensor: 'Schematic: cardiac MRI features and clinical variables combine through a tensor product to estimate pulmonary arterial wedge pressure.',
  pykale: 'Schematic: image, signal and omics sources pass through shared prepdata, embed and predict pipeline stages.',
};
---

<ul class="projects">
  {
    projects.map((project) => (
      <li class="project">
        <div class="project-figure">
          <ProjectDiagram kind={project.diagram} label={diagramLabels[project.diagram]} />
        </div>
        <div class="project-body">
          <div class="project-head">
            <h3 class="project-title">{project.title}</h3>
            {project.venue && <p class="project-venue mono">{project.venue}</p>}
          </div>
          <p class="project-problem">{project.problem}</p>
          <p class="project-contribution">{project.contribution}</p>
          <div class="project-foot">
            <ul class="chip-row">
              {project.modalities.map((modality) => (
                <li class="chip">{modality}</li>
              ))}
            </ul>
            <ul class="link-list project-links">
              {project.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.label}
                    <Icon name="arrow" size={13} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .project {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .project:hover {
    border-color: var(--line-strong);
  }

  .project-figure {
    padding: var(--s-5) var(--s-5) 0;
    background: linear-gradient(var(--surface-2), var(--surface));
    border-bottom: 1px solid var(--line);
  }

  .project-body {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-bottom: var(--s-3);
  }

  .project-title {
    font-size: var(--step-2);
  }

  .project-venue {
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .project-problem {
    font-size: var(--step-0);
    color: var(--ink);
    margin-bottom: var(--s-3);
  }

  .project-contribution {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .project-foot {
    margin-top: auto;
    padding-top: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  @media (max-width: 820px) {
    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
