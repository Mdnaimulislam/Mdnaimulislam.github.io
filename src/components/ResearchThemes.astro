---
import { researchThemes } from '../data/research';
import { publications } from '../data/publications';

const byId = new Map(publications.map((p) => [p.id, p]));
---

<ol class="themes">
  {
    researchThemes.map((theme, index) => (
      <li class="theme">
        <p class="theme-index mono">{String(index + 1).padStart(2, '0')}</p>
        <div class="theme-body">
          <h3 class="theme-title">{theme.title}</h3>
          <p class="theme-question">{theme.question}</p>
          <p class="theme-text">{theme.body}</p>
          <ul class="chip-row theme-modalities">
            {theme.modalities.map((modality) => (
              <li class="chip">{modality}</li>
            ))}
          </ul>
          <div class="theme-work">
            <span class="theme-work-label mono">Key work</span>
            <ul class="theme-work-list">
              {theme.keyWork.map((id) => {
                const pub = byId.get(id);
                return pub ? (
                  <li>
                    <a href={`#pub-${pub.id}`}>
                      <span class="theme-work-venue">{pub.venueShort}</span>
                      <span class="theme-work-title">{pub.title}</span>
                    </a>
                  </li>
                ) : null;
              })}
            </ul>
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .themes {
    display: grid;
    gap: 0;
  }

  .theme {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .theme:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .theme-index {
    color: var(--accent);
    font-size: var(--step--1);
    padding-top: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .theme-title {
    font-size: var(--step-2);
    letter-spacing: -0.012em;
  }

  .theme-question {
    margin: var(--s-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--accent);
    max-width: 54ch;
    line-height: 1.45;
  }

  .theme-text {
    margin: var(--s-4) 0 0;
    color: var(--ink-2);
    max-width: 66ch;
  }

  .theme-modalities {
    margin-top: var(--s-4);
  }

  .theme-work {
    margin-top: var(--s-5);
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
    max-width: 78ch;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .theme-work-label {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 0.25rem;
  }

  .theme-work-list {
    display: grid;
    gap: 0.35rem;
  }

  .theme-work-list a {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink-2);
    font-size: var(--step--1);
    padding: 0.2rem 0;
    border-radius: 3px;
  }

  .theme-work-list a:hover .theme-work-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .theme-work-venue {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-top: 0.1rem;
  }

  .theme-work-title {
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .theme {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }

    .theme-index {
      padding-top: 0;
    }

    .theme-work,
    .theme-work-list a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }

    .theme-work-label {
      padding-top: 0;
    }

    .theme-work-list a {
      gap: 0.1rem;
      padding: 0.3rem 0;
    }
  }
</style>
