---
import { software } from '../data/cv';
import Icon from './Icon.astro';
---

<ul class="software">
  {
    software.map((item) => (
      <li class="software-item">
        <div class="software-name-col">
          <h3 class="software-name">
            <a href={item.href} target="_blank" rel="noopener">
              {item.name}
              <Icon name="arrow" size={13} />
            </a>
          </h3>
          {item.meta && <p class="software-meta mono">{item.meta}</p>}
        </div>
        <div class="software-body">
          <p class="software-role">{item.role}</p>
          <p class="software-desc">{item.description}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .software-item {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-4);
    align-items: start;
  }

  .software-item + .software-item {
    border-top: 1px solid var(--line);
  }

  .software-name {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
  }

  .software-name a {
    display: inline;
    color: inherit;
    text-decoration: none;
  }

  .software-name a:hover {
    color: var(--accent);
  }

  .software-name :global(svg) {
    vertical-align: -1px;
    margin-left: 0.15rem;
    color: var(--accent);
  }

  .software-meta {
    margin: 0.2rem 0 0;
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .software-role {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
  }

  .software-desc {
    margin: 0.25rem 0 0;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 74ch;
  }

  @media (max-width: 760px) {
    .software-item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }
  }
</style>
