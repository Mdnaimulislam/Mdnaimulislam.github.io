---
import { awards, talks } from '../data/cv';
---

<div class="split">
  <div class="split-col">
    <h3 class="split-title">Honours and awards</h3>
    <ol class="award-list">
      {
        awards.map((award) => (
          <li class="award">
            <p class="award-year mono">{award.year}</p>
            <div>
              <p class="award-title">{award.title}</p>
              <p class="award-org">{award.org}</p>
              {award.detail && <p class="award-detail">{award.detail}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="split-col">
    <h3 class="split-title">Invited and conference talks</h3>
    <ol class="award-list">
      {
        talks.map((talk) => (
          <li class="award">
            <p class="award-year mono">{talk.date.split(' ')[1]}</p>
            <div>
              <p class="award-title">{talk.title}</p>
              <p class="award-org">{talk.event}</p>
              <p class="award-detail">
                {talk.venue}, {talk.date}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }

  .split-title {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-4);
  }

  .award {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--s-3);
    padding-block: var(--s-4);
  }

  .award + .award {
    border-top: 1px solid var(--line);
  }

  .award-year {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
  }

  .award-title {
    margin: 0;
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.4;
  }

  .award-org {
    margin: 0.2rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .award-detail {
    margin: 0.2rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }
  }

  @media (max-width: 480px) {
    .award {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }
</style>
