---
import { awards, service } from '../data/cv';
---

<div class="split">
  <section aria-label="Honours and awards">
    <h3 class="split-title">Honours and awards</h3>
    <ol class="award-list">
      {
        awards.map((award) => (
          <li>
            <p class="award-year mono">{award.year}</p>
            <div>
              <p class="award-title">{award.title}</p>
              <p class="award-org">{award.org}</p>
              {award.detail && <p class="award-detail">{award.detail}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-label="Academic service">
    <h3 class="split-title">Academic service</h3>
    {
      service.map((group) => (
        <div class="service-group">
          <p class="service-heading">{group.heading}</p>
          <ul class="service-items">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .split-title {
    font-size: var(--step-0);
    font-weight: 600;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-3);
  }

  .award-list li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--s-3);
    padding-block: var(--s-3);
  }

  .award-list li + li {
    border-top: 1px solid var(--line);
  }

  .award-year {
    margin: 0;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .award-title {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.45;
  }

  .award-org {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .award-detail {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .service-group + .service-group {
    margin-top: var(--s-4);
  }

  .service-heading {
    margin: 0 0 var(--s-2);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .service-items li {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-2);
    padding-left: 0.9rem;
    position: relative;
  }

  .service-items li + li {
    margin-top: 0.3rem;
  }

  .service-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent-line);
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
  }
</style>
