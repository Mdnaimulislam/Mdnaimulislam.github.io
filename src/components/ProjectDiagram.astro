---
/**
 * Small schematics drawn in the site's own visual language. They abstract the
 * published architectures (inputs, fusion, output) — they are not figures
 * reproduced from the papers.
 */
interface Props {
  kind: 'cardiovae' | 'lsemvae' | 'tensor' | 'pykale';
  label: string;
}
const { kind, label } = Astro.props;
---

<svg class="diagram" viewBox="0 0 320 128" role="img" aria-label={label}>
  {
    kind === 'cardiovae' && (
      <g>
        <rect class="d-box" x="6" y="16" width="72" height="34" rx="6" />
        <text class="d-label" x="42" y="37">CXR</text>
        <rect class="d-box" x="6" y="78" width="72" height="34" rx="6" />
        <text class="d-label" x="42" y="99">ECG</text>
        <path class="d-line" d="M78 33h26c12 0 12 15 24 15" />
        <path class="d-line" d="M78 95h26c12 0 12-15 24-15" />
        <rect class="d-node" x="128" y="44" width="66" height="40" rx="8" />
        <text class="d-label d-label--node" x="161" y="62">shared</text>
        <text class="d-label d-label--node" x="161" y="75">latent</text>
        <path class="d-line d-line--arrow" d="M194 64h44" />
        <rect class="d-box d-box--out" x="240" y="47" width="74" height="34" rx="6" />
        <text class="d-label" x="277" y="68">instability</text>
      </g>
    )
  }
  {
    kind === 'lsemvae' && (
      <g>
        <text class="d-caption" x="6" y="16">12-lead</text>
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect class="d-tick" x={6 + i * 10} y="26" width="5" height={i % 2 === 0 ? 26 : 18} rx="2" />
        ))}
        <text class="d-caption" x="6" y="78">6-lead</text>
        {[0, 1, 2, 3].map((i) => (
          <rect class="d-tick d-tick--alt" x={6 + i * 10} y="86" width="5" height="20" rx="2" />
        ))}
        <path class="d-line" d="M92 39h22c14 0 10 20 24 20" />
        <path class="d-line" d="M52 96h62c14 0 10-20 24-20" />
        <rect class="d-node" x="136" y="44" width="62" height="34" rx="8" />
        <text class="d-label d-label--node" x="167" y="65">HiME</text>
        <path class="d-line d-line--arrow" d="M198 61h40" />
        <rect class="d-box d-box--out" x="240" y="44" width="74" height="34" rx="6" />
        <text class="d-label" x="277" y="65">PH risk</text>
      </g>
    )
  }
  {
    kind === 'tensor' && (
      <g>
        {[0, 1, 2].map((row) =>
          [0, 1, 2].map((col) => (
            <rect class="d-cell" x={10 + col * 20} y={22 + row * 20} width="15" height="15" rx="2" />
          ))
        )}
        <text class="d-caption" x="10" y="98">cardiac MRI</text>
        {[0, 1, 2].map((i) => (
          <rect class="d-tick d-tick--alt" x="100" y={26 + i * 18} width="42" height="9" rx="3" />
        ))}
        <text class="d-caption" x="100" y="98">clinical</text>
        <circle class="d-node d-node--round" cx="182" cy="52" r="16" />
        <text class="d-label d-label--node" x="182" y="57">⊗</text>
        <path class="d-line" d="M70 44h94" />
        <path class="d-line" d="M142 52h22" />
        <path class="d-line d-line--arrow" d="M198 52h42" />
        <rect class="d-box d-box--out" x="242" y="35" width="72" height="34" rx="6" />
        <text class="d-label" x="278" y="56">PAWP</text>
      </g>
    )
  }
  {
    kind === 'pykale' && (
      <g>
        {[0, 1, 2].map((i) => (
          <rect class="d-box" x="6" y={12 + i * 38} width="58" height="28" rx="6" />
        ))}
        <text class="d-label" x="35" y="30">image</text>
        <text class="d-label" x="35" y="68">signal</text>
        <text class="d-label" x="35" y="106">omics</text>
        <path class="d-line" d="M64 26h22c10 0 8 34 18 34" />
        <path class="d-line" d="M64 64h40" />
        <path class="d-line" d="M64 102h22c10 0 8-34 18-34" />
        <rect class="d-node" x="104" y="46" width="52" height="30" rx="8" />
        <text class="d-label d-label--node" x="130" y="65">prepdata</text>
        <path class="d-line d-line--arrow" d="M156 61h16" />
        <rect class="d-node" x="172" y="46" width="52" height="30" rx="8" />
        <text class="d-label d-label--node" x="198" y="65">embed</text>
        <path class="d-line d-line--arrow" d="M224 61h16" />
        <rect class="d-node" x="240" y="46" width="58" height="30" rx="8" />
        <text class="d-label d-label--node" x="269" y="65">predict</text>
      </g>
    )
  }
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    display: block;
  }

  .d-box,
  .d-tick,
  .d-cell {
    fill: var(--surface-2);
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .d-box--out {
    fill: transparent;
    stroke-dasharray: 3 3;
  }

  .d-tick--alt {
    fill: var(--accent-soft);
    stroke: var(--accent-line);
  }

  .d-node {
    fill: var(--accent-soft);
    stroke: var(--accent-line);
    stroke-width: 1.2;
  }

  .d-line {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .d-line--arrow {
    marker-end: none;
    stroke-dasharray: 0;
  }

  .d-label {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ink-2);
    text-anchor: middle;
  }

  .d-label--node {
    fill: var(--accent);
  }

  .d-caption {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-3);
  }
</style>
