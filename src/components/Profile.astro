---
import { site, links } from '../data/site';
import Icon from './Icon.astro';
---

<section class="profile" id="about">
  <div class="wrap profile-grid">
    <div class="identity">
      <picture>
        <source srcset="/img/portrait.webp" type="image/webp" />
        <img
          class="portrait"
          src="/img/portrait.jpg"
          width="360"
          height="360"
          alt={`Portrait of ${site.name}`}
          fetchpriority="high"
        />
      </picture>
      <h1 class="identity-name">{site.name}</h1>
      <p class="identity-role">{site.role}</p>
      <p class="identity-affiliation">
        {site.group}<br />
        {site.institution}
      </p>
      <ul class="identity-links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                title={link.label}
                aria-label={link.label}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener' : undefined}
              >
                <Icon name={link.icon} size={17} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bio">
      {site.bio.map((paragraph) => <p set:html={paragraph} />)}

      <h2 class="bio-heading">Research interests</h2>
      <ul class="interests">
        {
          site.interests.map((interest) => (
            <li>
              <span class="interest-label">{interest.label}</span>
              <span class="interest-detail">{interest.detail}</span>
            </li>
          ))
        }
      </ul>

      <p class="metrics">
        {site.metrics.citations} citations <span aria-hidden="true">·</span> h-index {site.metrics.hIndex}
        <span aria-hidden="true">·</span> i10-index {site.metrics.i10Index}
        <span class="metrics-note">
          (<a href={site.metrics.source} target="_blank" rel="noopener">Google Scholar</a>, {site.metrics.asOf})
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .profile {
    padding-block: clamp(2.5rem, 5.5vw, 4.25rem) clamp(1.75rem, 3vw, 2.5rem);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 20.5rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .identity {
    text-align: center;
  }

  .portrait {
    width: 16rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto var(--s-4);
    border: 1px solid var(--line);
  }

  .identity-name {
    font-size: clamp(1.75rem, 1.35rem + 1.1vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.014em;
    line-height: 1.2;
  }

  .identity-role {
    margin: var(--s-3) 0 0;
    font-size: var(--step-1);
    color: var(--accent);
    font-weight: 500;
  }

  .identity-affiliation {
    margin: var(--s-2) 0 0;
    font-size: var(--step-1);
    color: var(--ink-3);
    line-height: 1.55;
  }

  .identity-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--s-5);
  }

  .identity-links a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink-2);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .identity-links a:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .bio p {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.7;
    max-width: 72ch;
  }

  .bio-heading {
    font-size: var(--step-1);
    font-weight: 600;
    margin: var(--s-5) 0 var(--s-3);
  }

  .interests li {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--s-3);
    padding: 0.4rem 0;
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .interest-label {
    font-weight: 600;
    color: var(--ink);
  }

  .interest-detail {
    color: var(--ink-2);
  }

  .metrics {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-size: var(--step-0);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .metrics-note {
    color: var(--ink-3);
    margin-left: 0.35rem;
  }

  @media (max-width: 820px) {
    .profile-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }

    .identity {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: var(--s-4);
      text-align: left;
      align-items: center;
    }

    .portrait {
      width: 6rem;
      margin: 0;
      grid-row: span 2;
    }

    .identity-name {
      align-self: end;
      margin: 0;
    }

    .identity-role,
    .identity-affiliation {
      grid-column: 2;
      align-self: start;
    }

    .identity-affiliation {
      margin-top: 0.15rem;
    }

    .identity-links {
      grid-column: 1 / -1;
      justify-content: flex-start;
      margin-top: var(--s-2);
    }

    .interests li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 0.4rem 0;
    }
  }
</style>
