---
import { service } from '../data/cv';
---

<div class="service-grid">
  {
    service.map((group) => (
      <section class="service-group" aria-label={group.heading}>
        <h3 class="service-heading">{group.heading}</h3>
        <ul class="service-items">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-6) clamp(2rem, 5vw, 3.5rem);
  }

  .service-heading {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-4);
  }

  .service-items li {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
    padding-left: 1rem;
    position: relative;
  }

  .service-items li + li {
    margin-top: var(--s-3);
  }

  .service-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent-line);
  }
</style>
