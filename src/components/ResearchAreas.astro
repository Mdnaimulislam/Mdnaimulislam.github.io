---
import { researchAreas } from '../data/research';
import { publications } from '../data/publications';

const byId = new Map(publications.map((p) => [p.id, p]));
---

<ol class="areas">
  {
    researchAreas.map((area) => {
      const credit = byId.get(area.figureCredit);
      return (
        <li class="area">
          <figure class="area-figure">
            <picture>
              <source srcset={`/img/research/${area.id}.webp`} type="image/webp" />
              <img src={`/img/research/${area.id}.jpg`} alt={area.figureAlt} loading="lazy" decoding="async" />
            </picture>
            {credit && (
              <figcaption>
                Figure from the {credit.links.length ? <a href={credit.links[0].href} target="_blank" rel="noopener">{credit.venueShort}</a> : credit.venueShort} paper
              </figcaption>
            )}
          </figure>

          <div class="area-body">
            <h3 class="area-title">{area.title}</h3>
            <p class="area-text">{area.body}</p>
            <ul class="area-links">
              {area.keyWork.map((id) => {
                const pub = byId.get(id);
                return pub ? (
                  <li>
                    <a href={`#pub-${pub.id}`}>
                      {pub.title} <span class="area-venue">{pub.venueShort}</span>
                    </a>
                  </li>
                ) : null;
              })}
            </ul>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .area {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .area + .area {
    border-top: 1px solid var(--line);
  }

  .area-figure {
    margin: 0;
  }

  .area-figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }

  .area-figure figcaption {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .area-title {
    font-size: var(--step-1);
    font-weight: 600;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  .area-text {
    margin: var(--s-3) 0 0;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-2);
  }

  .area-links {
    margin-top: var(--s-4);
    display: grid;
    gap: 0.35rem;
  }

  .area-links a {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.25rem;
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .area-links a:hover {
    color: var(--accent);
  }

  .area-links a::before {
    content: '→';
    color: var(--accent);
  }

  .area-venue {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .area {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }
  }
</style>
