---
import Base from '../layouts/Base.astro';
import Profile from '../components/Profile.astro';
import Section from '../components/Section.astro';
import News from '../components/News.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import Publications from '../components/Publications.astro';
import SoftwareList from '../components/SoftwareList.astro';
import Talks from '../components/Talks.astro';
import Experience from '../components/Experience.astro';
import AwardsService from '../components/AwardsService.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const title = `${site.name} — ${site.role}, ${site.institution}`;
const description =
  'AI Research Engineer at the Centre for Machine Intelligence, University of Sheffield, working on multimodal machine learning for cardiovascular health and medical imaging.';
---

<Base title={title} description={description}>
  <Profile />

  <Section id="news" title="News">
    <News />
  </Section>

  <Section id="research" title="Research">
    <ResearchAreas />
  </Section>

  <Section id="publications" title="Publications">
    <Publications />
  </Section>

  <Section id="software" title="Software">
    <SoftwareList />
  </Section>

  <Section id="talks" title="Talks">
    <Talks />
  </Section>

  <Section id="experience" title="Experience and education">
    <Experience />
  </Section>

  <Section id="service" title="Awards and service">
    <AwardsService />
  </Section>

  <Section id="contact" title="Contact">
    <Contact />
  </Section>
</Base>
